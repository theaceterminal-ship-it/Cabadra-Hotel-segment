{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cabadra-hotel-segment",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    // The real fix for client-side routing on this deployment type (Workers
    // with static assets, not classic Cloudflare Pages) — a public/_redirects
    // file's "/* /index.html 200" rule, the standard Pages-era SPA fallback,
    // gets rejected here with "Invalid _redirects configuration: Infinite
    // loop detected" (error 100324), because /index.html itself also
    // matches /*. This setting is the native equivalent for this deployment
    // model: any path with no matching static file serves index.html
    // instead of a 404, letting React Router handle it client-side.
    "not_found_handling": "single-page-application"
  },
  // Required by `npx wrangler preview`, the deploy command Workers Builds runs
  // for non-production branches; without it every PR build fails at the
  // deploy step. Empty because this Worker has no vars or bindings — assets
  // and compatibility settings stay at the top level and apply to previews.
  // If vars or bindings are ever added, give them Preview-safe values here:
  // previews do not inherit them from the top level.
  "previews": {}
}
