# --- Supabase ---
# From your project: Project Settings > API. The anon key is safe to expose
# in the browser (that's what it's for) — every table has Row Level
# Security enabled, so this key alone can't read or write anything beyond
# what a signed-in staff member's own rows allow, plus the guest_* RPC
# functions. NEVER put the service_role key in a VITE_ variable — that key
# bypasses RLS entirely and must never reach the browser.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# --- Cloudinary (optional — only needed for the photo-upload buttons in
# Rooms/Menu/Property management; everything else works without it) ---
# Cloud name: your Cloudinary dashboard home page.
# Upload preset: Cloudinary dashboard > Settings > Upload > Add upload
# preset > Signing Mode: Unsigned. Both values are meant to be public/
# client-side — the preset itself is what constrains uploads, not secrecy
# of these two values. Never put your Cloudinary API secret here.
VITE_CLOUDINARY_CLOUD_NAME="your-cloud-name"
VITE_CLOUDINARY_UPLOAD_PRESET="your-unsigned-preset-name"
